fn calculate() -> i32 {
  let mut total: i32 = 0;
  for (let mut index: i32 = 0; index < 5; index += 1) {
    defer {
      total += 10;
    }
    if index == 1 {
      continue;
    };
    if index == 3 {
      break;
    };
    total += 1;
  };
  total
}

@entry
fn application_main() -> c_int {
  calculate() as c_int
}

